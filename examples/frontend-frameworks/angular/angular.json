{
  "version": 1,
  "projects": {
    "reference": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "outputPath": "dist",
            "optimization": true,
            "sourceMap": false
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "reference:build",
            "proxyConfig": "proxy.conf.json"
          }
        }
      }
    }
  }
}
