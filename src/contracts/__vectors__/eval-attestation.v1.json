{
  "contract": "EvalAttestationRequest",
  "schemaVersion": 1,
  "endpoint": {
    "method": "POST",
    "path": "/v1/apps/:appId/eval-attestations",
    "auth": "x-api-key: the app's CI API key (GLIRASTES_API_KEY)"
  },
  "sources": {
    "setupArtifactDigest": ".glirastes/setup-artifact.json#discoveryDigest (the Platform stores it on every config revision as setupArtifactDigest)",
    "promptDigest": ".glirastes/setup-artifact.json#prompts.bundleDigest (the deployment's promptDigest)",
    "result": "pass when failed is 0, otherwise fail"
  },
  "suiteDigest": {
    "algorithm": "sha256 base64url over canonicalRuntimeJson({ schemaVersion: 1, files }), files sorted by path in code point order; each entry { path: relative POSIX path, sha256: sha256 base64url of the file bytes }; a single file is listed under its base name",
    "files": [
      { "path": "cases/routing.jsonl", "utf8": "{\"input\":\"x\"}\n" },
      { "path": "README.md", "utf8": "suite\n" },
      { "path": "cases/approvals.jsonl", "utf8": "{\"input\":\"y\"}\n" }
    ],
